Options -Indexes
DirectoryIndex index.php

<FilesMatch "\.(sql|gz|log|bak|gitignore|py|md)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(inc|views|tools)/ - [F,L]
  RewriteRule (^|/)\.(git|env|ht) - [F,L]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteRule ^blog/?$ index.php?p=blog [QSA,L]
  RewriteRule ^blog/([a-z0-9-]+)/?$ index.php?p=post&slug=$1 [QSA,L]
  RewriteRule ^(about|privacy-policy|terms|disclaimer|contact)/?$ index.php?p=page&slug=$1 [QSA,L]
  RewriteRule ^shop/?$ index.php?p=store [QSA,L]
  RewriteRule ^shop/(\d+)(-[a-z0-9-]*)?/?$ index.php?p=store_product&id=$1 [QSA,L]
  RewriteRule ^cart/?$ index.php?p=store_cart [QSA,L]
  RewriteRule ^checkout/?$ index.php?p=store_checkout [QSA,L]
  RewriteRule ^track/?$ index.php?p=track [QSA,L]
  RewriteRule ^sitemap\.xml$ index.php?p=sitemap [L]
  RewriteRule ^robots\.txt$ index.php?p=robots [L]
  RewriteRule ^ads\.txt$ index.php?p=adstxt [L]
</IfModule>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Powered-By
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteRule ^tools/ - [F,L]
</IfModule>
